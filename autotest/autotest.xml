<?xml version="1.0"?>
<!--
    F-15 Master Autotest Configuration

    Defines all test groups, individual tests, and their output file mappings.
    Tolerance rules are in validation-package/tolerances.xml (separate concern).
    Per-group metadata is in each group's test-definition.xml.
-->
<autotest-suite aircraft="F-15">

  <paths>
    <tolerances>validation-package/tolerances.xml</tolerances>
    <baselines>validation-package/</baselines>
    <output>output/</output>
    <init>init/</init>
  </paths>

  <!-- ================================================================== -->
  <!-- Flight Control System Tests                                        -->
  <!-- ================================================================== -->

  <test-group name="fcs" definition="fcs/test-definition.xml">

    <test name="fcs-pitch-cas"
          script="fcs/fcs-pitch-cas.xml">
      <description>Pitch CAS PI controller with washout, lead-lag, authority limit</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-pitch-cas.csv"
                   baseline="fcs-pitch-cas.csv"/>
    </test>

    <test name="fcs-roll-cas"
          script="fcs/fcs-roll-cas.xml">
      <description>Roll CAS rate-command error gain and AOA authority</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-roll-cas.csv"
                   baseline="fcs-roll-cas.csv"/>
    </test>

    <test name="fcs-yaw-cas"
          script="fcs/fcs-yaw-cas.xml">
      <description>Yaw CAS notch filter, washout, PI controller, AOA crossfeed</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-yaw-cas.csv"
                   baseline="fcs-yaw-cas.csv"/>
    </test>

    <test name="fcs-ptc-closed-loop"
          script="fcs/fcs-ptc-closed-loop.xml">
      <description>Pitch trim compensation closed-loop Nz tracking</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-ptc-closed-loop.csv"
                   baseline="fcs-ptc-closed-loop.csv"/>
    </test>

    <test name="fcs-sensors"
          script="fcs/fcs-sensors.xml">
      <description>FCS sensor processing: rates, AOA, Nz</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-sensors.csv"
                   baseline="fcs-sensors.csv"/>
    </test>

    <test name="fcs-mechanical-path"
          script="fcs/fcs-mechanical-path.xml">
      <description>Mechanical path: pitch/roll ratio scheduling, trim, gear effects</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-mechanical-path.csv"
                   baseline="fcs-mechanical-path.csv"/>
    </test>

    <test name="fcs-departure-protection"
          script="fcs/fcs-departure-protection.xml">
      <description>Departure protection: CAS shutdown, spin recovery, authority reduction</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-departure-protection.csv"
                   baseline="fcs-departure-protection.csv"/>
    </test>

    <test name="fcs-ari"
          script="fcs/fcs-ari.xml">
      <description>Aileron-Rudder Interconnect mechanical and CAS paths</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-ari.csv"
                   baseline="fcs-ari.csv"/>
    </test>

    <test name="fcs-stall-inhibitor"
          script="fcs/fcs-stall-inhibitor.xml">
      <description>Stall inhibitor AOA gate and pitch-down command</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-stall-inhibitor.csv"
                   baseline="fcs-stall-inhibitor.csv"/>
    </test>

    <test name="fcs-cas-on-off"
          script="fcs/fcs-cas-on-off.xml">
      <description>CAS enable/disable effect on all three axes</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-cas-on-off.csv"
                   baseline="fcs-cas-on-off.csv"/>
    </test>

    <test name="fcs-output-scaling"
          script="fcs/fcs-output-scaling.xml">
      <description>Surface position output scaling: deg, rad, norm conversions</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-output-scaling.csv"
                   baseline="fcs-output-scaling.csv"/>
    </test>

    <test name="fcs-actuators-hydraulic"
          script="fcs/fcs-actuators-hydraulic.xml">
      <description>Actuator response with and without hydraulic pressure</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-actuators-hydraulic.csv"
                   baseline="fcs-actuators-hydraulic.csv"/>
    </test>

    <test name="fcs-roll-channel-diagnostic"
          script="fcs/fcs-roll-channel-diagnostic.xml">
      <description>Full roll channel diagnostic: input through to surface position</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-roll-channel-diagnostic.csv"
                   baseline="fcs-roll-channel-diagnostic.csv"/>
    </test>

    <test name="fcs-engineering-units"
          script="fcs/fcs-engineering-units.xml">
      <description>Engineering units signal path: inch/degree conversion end-to-end</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-engineering-units.csv"
                   baseline="fcs-engineering-units.csv"/>
    </test>

    <test name="fcs-pitch-mixer-deg"
          script="fcs/fcs-pitch-mixer-deg.xml">
      <description>Pitch mixer degree-domain architecture: PTC sole authority, no direct stick</description>
      <data-source level="predicted"/>
      <output-file name="autotest/output/fcs-pitch-mixer-deg.csv"
                   baseline="fcs-pitch-mixer-deg.csv"/>
    </test>

  </test-group>

</autotest-suite>
