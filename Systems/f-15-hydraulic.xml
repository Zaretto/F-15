<?xml version="1.0"?>
<!--
        Description: F-15 hydraulic system
        Notes: Three independent hydraulic systems per TO 1F-15A-1, Figure FO-6:
               PC1  - Power Control 1, driven by left AMAD pump (engine[0])
               PC2  - Power Control 2, driven by right AMAD pump (engine[1])
               Utility - dual pump: left pump (left AMAD, 3000 psi) + right pump (right AMAD, 2775 psi)

               Flight control actuators are tandem (PC1+PC2); either system alone is adequate.
               Utility powers: gear, flaps, speedbrake, NWS, hook, inlet ramps, CSBPC pitch/roll ratio.
               JFS accumulator is recharged from utility system.

               Sufficient hydraulic pressure for smooth flight control inputs should
               be available with one engine windmilling at 18 percent rpm or two
               engines at 11 percent rpm.

        Author: Richard Harrison (rjh@zaretto.com)
    -->

<system name="hydraulic">

    <!-- ================================================================== -->
    <!-- PC1: Power Control 1 — left engine (AMAD) pump                     -->
    <!-- ================================================================== -->
    <channel name="PC1" execrate="4">
        <scheduled_gain name="systems/hydraulics/pc1-pump-psi">
            <input>propulsion/engine[0]/n2</input>
            <table>
                <independentVar lookup="row">propulsion/engine[0]/n2</independentVar>
                <independentVar lookup="column">systems/hydraulics/pc1-pump-failed</independentVar>
                <tableData>
                        0      1
                    0   0      0
                    18  130    0
                </tableData>
            </table>
            <clipto>
                <min>0</min>
                <max>systems/hydraulics/normal-pressure</max>
            </clipto>
        </scheduled_gain>

        <summer name="systems/hydraulics/pc1-psi">
            <input>systems/hydraulics/pc1-pump-psi</input>
            <input>-systems/hydraulics/pc1-bleed</input>
            <clipto>
                <min>0</min>
                <max>3100</max>
            </clipto>
        </summer>

        <switch name="systems/hydraulics/pc1-pressure">
            <default value="0"/>
            <test logic="AND" value="1">
                systems/hydraulics/pc1-psi ge 1800
            </test>
        </switch>
    </channel>

    <!-- ================================================================== -->
    <!-- PC2: Power Control 2 — right engine (AMAD) pump                    -->
    <!-- ================================================================== -->
    <channel name="PC2" execrate="4">
        <scheduled_gain name="systems/hydraulics/pc2-pump-psi">
            <input>propulsion/engine[1]/n2</input>
            <table>
                <independentVar lookup="row">propulsion/engine[1]/n2</independentVar>
                <independentVar lookup="column">systems/hydraulics/pc2-pump-failed</independentVar>
                <tableData>
                        0      1
                    0   0      0
                    18  130    0
                </tableData>
            </table>
            <clipto>
                <min>0</min>
                <max>systems/hydraulics/normal-pressure</max>
            </clipto>
        </scheduled_gain>

        <summer name="systems/hydraulics/pc2-psi">
            <input>systems/hydraulics/pc2-pump-psi</input>
            <input>-systems/hydraulics/pc2-bleed</input>
            <clipto>
                <min>0</min>
                <max>3100</max>
            </clipto>
        </summer>

        <switch name="systems/hydraulics/pc2-pressure">
            <default value="0"/>
            <test logic="AND" value="1">
                systems/hydraulics/pc2-psi ge 1800
            </test>
        </switch>
    </channel>

    <!-- ================================================================== -->
    <!-- Flight Controls Pressure: tandem — either PC system is adequate    -->
    <!-- ================================================================== -->
    <channel name="FlightControlsPressure" execrate="4">
        <switch name="systems/hydraulics/flight-controls-pressure">
            <default value="0"/>
            <test logic="OR" value="1">
                systems/hydraulics/pc1-pressure eq 1
                systems/hydraulics/pc2-pressure eq 1
            </test>
        </switch>
    </channel>

    <!-- ================================================================== -->
    <!-- Bleed: flight control actuator load bleed from elevator deflection  -->
    <!-- Split equally between PC1 and PC2 tandem actuators                 -->
    <!-- ================================================================== -->
    <channel name="Bleed" execrate="4">
        <fcs_function name="fcs/elevator-normalization">
            <function>
                <quotient>
                    <property>fcs/elevator-pos-deg</property>
                    <value>29.0</value>
                </quotient>
            </function>
        </fcs_function>

        <summer name="systems/hydraulics/elevator-bleed">
            <input>-fcs/elevator-cmd-norm</input>
            <input>-fcs/elevator-normalization</input>
        </summer>

        <summer name="systems/hydraulics/flight-control-bleed-basic">
            <input>systems/hydraulics/elevator-bleed</input>
        </summer>

        <fcs_function name="systems/hydraulics/flight-control-bleed">
            <function>
                <product>
                    <property>systems/hydraulics/flight-control-bleed-basic</property>
                    <value>100</value>
                </product>
            </function>
            <clipto>
                <min>0</min>
                <max>300</max>
            </clipto>
        </fcs_function>

        <!-- Half to each tandem system -->
        <pure_gain name="systems/hydraulics/pc1-bleed">
            <input>systems/hydraulics/flight-control-bleed</input>
            <gain>0.5</gain>
        </pure_gain>

        <pure_gain name="systems/hydraulics/pc2-bleed">
            <input>systems/hydraulics/flight-control-bleed</input>
            <gain>0.5</gain>
        </pure_gain>
    </channel>

    <!-- ================================================================== -->
    <!-- Utility: dual pump system — L pump (left AMAD) + R pump (right AMAD) -->
    <!-- System pressurizes to the higher of the two pumps                   -->
    <!-- ================================================================== -->
    <channel name="Utility" execrate="4">
        <scheduled_gain name="systems/hydraulics/util-left-pump-psi">
            <input>propulsion/engine[0]/n2</input>
            <table>
                <independentVar lookup="row">propulsion/engine[0]/n2</independentVar>
                <independentVar lookup="column">systems/hydraulics/util-left-pump-failed</independentVar>
                <tableData>
                        0      1
                    0   0      0
                    18  130    0
                </tableData>
            </table>
            <clipto>
                <min>0</min>
                <max>systems/hydraulics/util-left-normal-pressure</max>
            </clipto>
        </scheduled_gain>

        <scheduled_gain name="systems/hydraulics/util-right-pump-psi">
            <input>propulsion/engine[1]/n2</input>
            <table>
                <independentVar lookup="row">propulsion/engine[1]/n2</independentVar>
                <independentVar lookup="column">systems/hydraulics/util-right-pump-failed</independentVar>
                <tableData>
                        0      1
                    0   0      0
                    18  130    0
                </tableData>
            </table>
            <clipto>
                <min>0</min>
                <max>systems/hydraulics/util-right-normal-pressure</max>
            </clipto>
        </scheduled_gain>

        <!-- System pressurizes to the higher pump output -->
        <fcs_function name="systems/hydraulics/util-pump-combined-psi">
            <function>
                <max>
                    <property>systems/hydraulics/util-left-pump-psi</property>
                    <property>systems/hydraulics/util-right-pump-psi</property>
                </max>
            </function>
        </fcs_function>

        <summer name="systems/hydraulics/util-system-bleed">
            <input>systems/hydraulics/util-pump-combined-psi</input>
            <input>systems/hydraulics/jfs-util-feedin</input>
            <input>-systems/hydraulics/emerg-gear-bleed</input>
            <input>-systems/hydraulics/emerg-gen-util-bleed</input>
        </summer>

        <fcs_function name="systems/hydraulics/util-system-input-psi">
            <function>
                <sum>
                    <property>systems/hydraulics/util-psi</property>
                    <product>
                        <property>systems/hydraulics/util-system-bleed</property>
                        <property>simulation/channel-dt</property>
                    </product>
                </sum>
            </function>
            <clipto>
                <min>0</min>
                <max>3100</max>
            </clipto>
        </fcs_function>

        <fcs_function name="systems/hydraulics/util-system-rate">
            <function>
                <product>
                    <property>systems/hydraulics/util-pump-combined-psi</property>
                    <value>0.6</value>
                </product>
            </function>
            <clipto>
                <min>50</min>
                <max>800</max>
            </clipto>
        </fcs_function>

        <actuator name="systems/hydraulics/util-accumulator">
            <input>systems/hydraulics/util-system-input-psi</input>
            <rate_limit>systems/hydraulics/util-system-rate</rate_limit>
            <output>systems/hydraulics/util-psi</output>
            <clipto>
                <min>0</min>
                <max>3100</max>
            </clipto>
        </actuator>

        <switch name="systems/hydraulics/util-pressure">
            <default value="0"/>
            <test logic="AND" value="1">
                systems/hydraulics/util-psi ge 1800
            </test>
        </switch>
    </channel>

    <!-- ================================================================== -->
    <!-- Emergency Generator: hydraulic motor on utility system              -->
    <!-- ================================================================== -->
    <channel name="EmergGen" execrate="4">
        <switch name="systems/hydraulics/emerg-gen">
            <default value="0"/>
            <test logic="AND" value="1">
                propulsion/jfs-running eq 0
                systems/hydraulics/util-psi ge 1100
                systems/electrics/emerg-generator-status eq 1
                systems/electrics/lgenerator-kva lt 20
                systems/electrics/rgenerator-kva lt 20
            </test>
        </switch>

        <fcs_function name="systems/hydraulics/emerg-gen-util-bleed">
            <function>
                <product>
                    <property>systems/hydraulics/emerg-gen</property>
                    <value>20</value>
                </product>
            </function>
            <clipto>
                <min>0</min>
                <max>20</max>
            </clipto>
        </fcs_function>
    </channel>

    <!-- ================================================================== -->
    <!-- JFS Accumulator: recharged from utility, depleted by JFS starts    -->
    <!-- Emergency gear uses JFS accumulators per TO 1F-15A-1               -->
    <!-- ================================================================== -->
    <channel name="JFSaccumulator" execrate="4">
        <fcs_function name="systems/hydraulics/jfs-util-feedin">
            <function>
                <product>
                    <property>propulsion/jfs-running</property>
                    <value>3000</value>
                    <property>simulation/channel-dt</property>
                </product>
            </function>
        </fcs_function>

        <fcs_function name="systems/hydraulics/jfs-accumulator-rate">
            <description>
                JFS accu is approx 10 times smaller than Util accum so adjust psi downwards by a
                factor of 10; this will then permit the same value to be used to deplete the utility
                and also replenish the JFS.

                We limit to 300 psi/sec by way of an approximation of flow.
                The factor of 10 and the limit of 300 are estimations because I could find no data.
            </description>
            <function>
                <product>
                    <sum>
                        <product>
                            <property>systems/hydraulics/jfs-bleed</property>
                            <value>-1</value>
                        </product>
                        <product>
                            <property>systems/hydraulics/emerg-gear-bleed</property>
                            <value>-1</value>
                        </product>
                        <ifthen>
                            <and>
                                <gt>
                                    <property>systems/hydraulics/util-psi</property>
                                    <value>400</value>
                                </gt>
                                <lt>
                                    <property>systems/hydraulics/jfs-accumulator-input-psi</property>
                                    <value>1999</value>
                                </lt>
                            </and>
                            <quotient>
                                <property>systems/hydraulics/util-psi</property>
                                <value>10</value>
                            </quotient>
                            <value>0</value>
                        </ifthen>
                    </sum>
                    <property>simulation/channel-dt</property>
                </product>
            </function>
        </fcs_function>

        <fcs_function name="systems/hydraulics/jfs-accumulator-input-psi">
            <function>
                <sum>
                    <property>systems/hydraulics/jfs-accumulator-rate</property>
                    <property>systems/hydraulics/jfs-accumulator-psi</property>
                </sum>
            </function>
            <clipto>
                <min>0</min>
                <max>2000</max>
            </clipto>
        </fcs_function>

        <fcs_function name="systems/hydraulics/jfs-accumulator">
            <function>
                <sum>
                    <property>systems/hydraulics/jfs-accumulator-input-psi</property>
                    <property>systems/hydraulics/jfs-accumulator-rate</property>
                </sum>
            </function>
            <output>systems/hydraulics/jfs-accumulator-psi</output>
            <clipto>
                <min>0</min>
                <max>2000</max>
            </clipto>
        </fcs_function>
    </channel>

</system>
